MEM_SIZE  = 16777216
OPT       = -O2
# w8a8 or w16a16: must match the headers generated by lmfrnet-utils/quantize.py
PRECISION ?= w8a8

ifeq ($(PRECISION), w16a16)
	QDEFS = -DW16A16
endif
DEFS += $(QDEFS)

ifeq ($(VEn), 1)
	DEFS += -DVECTOR
	ARCH  = rv32imc_zicsr_zve32x_zvl$(VLEN)b
else
	ARCH  = rv32imc_zicsr
endif

include ../../common/common.mk

# Host build (-DNO_RISCV): scalar kernels, prints the checksums to compare RTL runs against
HOST_CC ?= gcc

native: build/lmfrnet_native

build/lmfrnet_native: src/lmfrnet.c $(wildcard src/*.h) quant_shifts.h
	@mkdir -p build
	@printf "${RED}Compiling %s (host)...${NC}\n" "$<"
	@$(HOST_CC) -O2 -Wall -DNO_RISCV $(QDEFS) -I$(COMMON_DIR)/include $< -o $@

run-native: build/lmfrnet_native
	@./build/lmfrnet_native

# compares the checksums of image1 against the ones quantize.py computed
check-native: build/lmfrnet_native
	@./build/lmfrnet_native | sed -n '/^layer,checksum$$/,$$p' > build/checksums.txt
	@sed -n '/^layer,checksum$$/,$$p' golden.txt | diff - build/checksums.txt && echo "checksums match golden.txt"

clean-native:
	@rm -rf build

.PHONY: native run-native check-native clean-native
