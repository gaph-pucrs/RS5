# repro.env -- the ONLY file with site-specific settings (paths, tool versions, run knobs).
# Sourced by scripts/common.sh. Every value can also be overridden from the environment,
# e.g.  WORK=/scratch/me/repro scripts/run_all.sh H0

# ---- locations --------------------------------------------------------------------
# All outputs go under $WORK (default: <repro>/work).
export WORK=${WORK:-$REPRO/work}
# Temporary files of the EDA tools (Genus/Innovus/Xcelium honour TMPDIR). Default: under $WORK,
# so a full system /tmp cannot crash a run.
export REPRO_TMPDIR=${REPRO_TMPDIR:-$WORK/tmp}
# Standard-cell library files and cell names (steps 03-06): scripts/config/pdk.env, created from
# scripts/config/pdk.env.example. The library is under NDA, so pdk.env is site-local and not versioned.
export PDK_ENV=${PDK_ENV:-$REPRO/scripts/config/pdk.env}

# ---- tools ------------------------------------------------------------------------
# Versions used for the paper. load_tool is called by each step with the module(s) it needs;
# redefine it if your site does not use Environment Modules.
export MOD_GENUS=${MOD_GENUS:-genus/211}               # Cadence Genus 21.1
export MOD_INNOVUS=${MOD_INNOVUS:-innovus/211}         # Cadence Innovus 21.1 (stylus)
export MOD_XCELIUM=${MOD_XCELIUM:-xcelium/2303}        # Cadence Xcelium 23.03
export MOD_VERILATOR=${MOD_VERILATOR:-verilator/5.052} # Verilator 5.052
export MOD_RISCV=${MOD_RISCV:-riscv64-elf/15.2.0-gaph} # riscv64-elf-gcc 15.2.0 (newlib-nano), assembler with XKyber
load_tool() {
    [ -f /etc/profile.d/modules.sh ] && source /etc/profile.d/modules.sh
    module load "$@" >/dev/null 2>&1 || { echo "load_tool: module load $* failed" >&2; return 1; }
    # host C++ compiler for Verilator (C++20); harmless if absent
    [ -f /opt/rh/gcc-toolset-15/enable ] && source /opt/rh/gcc-toolset-15/enable
    return 0
}

# ---- operating point and run knobs ------------------------------------------------
export PERIOD_NS=${PERIOD_NS:-2.0}      # 500 MHz: synthesis, P&R and gate-level clock
export IN_DLY_NS=${IN_DLY_NS:-0.25}     # gate-level sim: transport delay on DUT inputs (see README, step 05)
export NCPU_SYNTH=${NCPU_SYNTH:-3}      # Genus threads (paper runs: 3)
export NCPU_PNR=${NCPU_PNR:-4}          # Innovus threads (paper runs: 4)
export MAXPAR=${MAXPAR:-4}              # run_all.sh: configurations processed in parallel
