# pdk.env.example -- template of the site-local standard-cell library settings (steps 03-06).
#   cp scripts/config/pdk.env.example scripts/config/pdk.env    # then fill in every value
# scripts/config/pdk.env is listed in .gitignore: it names files and cells of a library under NDA.
#
# Library used for the paper: TSMC 28 nm HPC+ standard cells, tcbn28hpcplusbwp30p140.
# Operating points (also the names of the MMMC views in tcl/):
#   SS  worst case  0.81 V, 125 C, RC worst   -> setup (synthesis, P&R)
#   TT  typical     0.90 V,  25 C, RC typical -> SDF of the gate-level simulation, power
#   FF  best case   0.99 V, -40 C, RC best    -> hold
# Every value below must be set; scripts/common.sh (need_pdk) checks that the files exist.

# ---- timing/power libraries (Liberty, NLDM) -----------------------------------------
export LIB_SS=/path/to/liberty_ss_0p81v_125c.lib
export LIB_TT=/path/to/liberty_tt_0p90v_25c.lib
export LIB_FF=/path/to/liberty_ff_0p99v_m40c.lib

# ---- physical views ---------------------------------------------------------------------
export LEF_TECH=/path/to/technology.tlef         # technology LEF (routing uses M2-M6)
export LEF_CELLS=/path/to/stdcells.lef           # standard-cell LEF

# ---- parasitic extraction (QRC tech files) -------------------------------------------------
export QRC_WORST=/path/to/qrc_tech_rcworst
export QRC_TYP=/path/to/qrc_tech_typical
export QRC_BEST=/path/to/qrc_tech_rcbest

# ---- Verilog simulation models of the cells, with specify blocks (step 05) ----------------
export CELLS_VERILOG=/path/to/stdcells.v

# ---- cells used by the P&R script (tcl/pnr.tcl); Tcl lists, separated by spaces -----------
export ENDCAP_LEFT="<left end-cap cell>"
export ENDCAP_RIGHT="<right end-cap cell>"
export WELLTAP_CELL="<well-tap cell>"                     # placed every 20 um
export TIE_CELLS="<tie-high cell> <tie-low cell>"
export FILLER_CELLS="<fillers, largest to smallest>"       # the paper's library has no 1-site filler
export CTS_BUF_CELLS="<clock buffers, 6 drive strengths>"
export CTS_INV_CELLS="<clock inverters, 6 drive strengths>"
export CTS_ICG_CELLS="<integrated clock-gating cells>"
# glob patterns of the base-cell names counted in pnr_numbers.txt
export CLK_BUF_PATTERNS="<pattern of clock buffers> <pattern of clock inverters>"   # clock_buf_inv_*
export ICG_PATTERN="<pattern of the clock-gating cells>"                            # clock_gates
